{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "oaktown-rentals-website",
  "main": "cms/worker.mjs",
  "compatibility_date": "2026-11-03",
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "previews": {}
}
