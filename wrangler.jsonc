{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "oaktown",
  "main": "cms/worker.mjs",
  "compatibility_date": "2026-11-03",
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "previews": {
    "d1_databases": [],
    "r2_buckets": [],
    "vars": {}
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "oaktown-properties",
      "database_id": "de551a7d-04b1-4db8-a673-852ac4881be5",
      "migrations_dir": "cms/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PHOTOS",
      "bucket_name": "oaktown-property-photos"
    }
  ],
  "vars": {
    "ACCESS_TEAM_DOMAIN": "shiny-tooth-131b.cloudflareaccess.com",
    "ACCESS_AUD": "719406d32732fb7e54c59538686044bc38f2c2e320e8b79354d08e0c685ff17c"
  }
}
