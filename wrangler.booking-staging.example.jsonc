{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Use a separate Worker and D1 database. All values below are examples.
  "name": "oaktown-booking-staging",
  "main": "cms/worker.mjs",
  "compatibility_date": "2026-11-03",
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "oaktown-booking-staging",
      "database_id": "00000000-0000-4000-8000-000000000000",
      "migrations_dir": "cms/migrations"
    }
  ],
  "triggers": { "crons": ["*/5 * * * *"] },
  "vars": {
    "PUBLIC_CATALOGUE_SOURCE": "file",
    "BOOKING_MODE": "off",
    "BOOKING_ORIGIN": "https://oaktown-booking-staging.example.workers.dev",
    "TURNSTILE_SITE_KEY": "REPLACE_WITH_STAGING_SITE_KEY",
    "ACCESS_TEAM_DOMAIN": "example.cloudflareaccess.com",
    "ACCESS_AUD": "REPLACE_WITH_STAGING_ACCESS_AUDIENCE"
  }
}
